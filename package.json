{
  "name": "5521-apphub-monorepo",
  "version": "1.0.0",
  "description": "5521 AppHub - Monorepo for Backend, Dashboard and Frontend",
  "private": true,
  "workspaces": [
    "backend",
    "dashboard"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:dashboard\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:dashboard": "cd dashboard && npm run dev",
    "build": "npm run build:backend && npm run build:dashboard",
    "build:backend": "cd backend && npm run build",
    "build:dashboard": "cd dashboard && npm run build",
    "install:all": "npm install && cd backend && npm install && cd ../dashboard && npm install",
    "clean": "npm run clean:backend && npm run clean:dashboard",
    "clean:backend": "cd backend && rm -rf node_modules package-lock.json",
    "clean:dashboard": "cd dashboard && rm -rf node_modules package-lock.json",
    "test": "npm run test:backend && npm run test:dashboard",
    "test:backend": "cd backend && npm test",
    "test:dashboard": "cd dashboard && npm test",
    "lint": "npm run lint:backend && npm run lint:dashboard",
    "lint:backend": "cd backend && npm run lint",
    "lint:dashboard": "cd dashboard && npm run lint",
    "format": "npm run format:backend && npm run format:dashboard",
    "format:backend": "cd backend && npm run format",
    "format:dashboard": "cd dashboard && npm run format"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/5521/apphub-monorepo.git"
  },
  "keywords": [
    "5521",
    "apphub",
    "monorepo",
    "backend",
    "dashboard",
    "frontend",
    "typescript",
    "nextjs",
    "express",
    "mongodb"
  ],
  "author": "5521 Team",
  "license": "MIT"
}
