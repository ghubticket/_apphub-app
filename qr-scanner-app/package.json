{
  "name": "qr-scanner-app",
  "version": "1.0.0",
  "type": "module",
  "description": "App PWA para validação de QR codes de ingressos - EventHub",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "get-ip": "node get-ip.js",
    "tunnel": "echo 'Inicie o túnel HTTPS em outro terminal:' && echo 'cloudflared tunnel --url http://localhost:5174' && echo '' && echo 'Ou use ngrok:' && echo 'ngrok http 5174'"
  },
