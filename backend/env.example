# Node Environment
NODE_ENV=development
PORT=3001

# Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/eventhub?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=seu-secret-super-seguro-minimo-32-caracteres-change-this-now
JWT_REFRESH_SECRET=seu-refresh-secret-super-seguro-minimo-32-caracteres-change-this-now
JWT_EXPIRES_IN=7d

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# QR Code Security (32 bytes = 64 chars HEX ou 44 chars Base64)
QR_SECRET=seu-qr-secret-hex-de-64-caracteres-ou-base64-de-44-caracteres
QR_HMAC_SECRET=seu-hmac-secret-hex-de-64-caracteres-ou-base64-de-44-caracteres

# Encryption Key for Sensitive Data (CPF, Phone) - 32 bytes = 64 chars HEX ou 44 chars Base64
# CRÍTICO: Gerar com: openssl rand -hex 32
# Em produção: usar serviço de secrets (AWS Secrets Manager, Azure Key Vault, etc.)
ENCRYPTION_KEY=seu-encryption-key-hex-de-64-caracteres-ou-base64-de-44-caracteres

# Mercado Pago (obter em: https://www.mercadopago.com.br/developers)
MP_ACCESS_TOKEN=APP_USR-seu-access-token-aqui
MP_PUBLIC_KEY=APP_USR-seu-public-key-aqui
# Flag para controlar se emails devem ser mockados em sandbox
# true  -> troca para @testuser.com (recomendado para desenvolvimento rápido)
# false -> usa o email real mesmo em sandbox (recomendado para ambiente de staging)
MP_EMAIL_MOCK_ENABLED=true

# Email (Resend - obter em: https://resend.com)
RESEND_API_KEY=re_sua_api_key_aqui
# Para testes, use: EventHub <onboarding@resend.dev>
# Para produção, configure seu domínio verificado: EventHub <noreply@seudominio.com>
RESEND_FROM_EMAIL=EventHub <onboarding@resend.dev>

# Upload (Cloudinary - obter em: https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=seu-cloud-name
CLOUDINARY_API_KEY=sua-api-key
CLOUDINARY_API_SECRET=seu-api-secret

# URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001
QR_SCANNER_URL=http://localhost:5174

# Monitoramento (Sentry - opcional)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Uploads/Imagens (hotlink protection em produção)
# Domínios autorizados a referenciar arquivos de /uploads
# FRONTEND_URL e DASHBOARD_URL já são usados como allowlist
DASHBOARD_URL=http://localhost:3000

# Cloudflare R2 (Object Storage)
# Obter em: https://dash.cloudflare.com/ -> R2 -> Manage R2 API Tokens
R2_ACCOUNT_ID=seu_account_id_aqui
R2_ACCESS_KEY_ID=seu_access_key_id_aqui
R2_SECRET_ACCESS_KEY=seu_secret_access_key_aqui
R2_BUCKET_NAME=app-hub
# URL pública do bucket (configurar após criar domínio customizado no R2)
# Exemplo: https://cdn.ghubtech.com.br ou https://pub-xxxxx.r2.dev
R2_PUBLIC_URL=

# Swagger/API Docs Protection (Basic Auth)
# Em produção, SEMPRE configure credenciais fortes!
SWAGGER_USER=admin
SWAGGER_PASSWORD=changeme
# Para desabilitar autenticação do Swagger (NÃO recomendado em produção):
# SWAGGER_AUTH_ENABLED=false

